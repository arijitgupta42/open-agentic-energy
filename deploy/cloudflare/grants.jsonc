// Cloudflare Workers static assets: serves sites/grants at https://fernbrook-grants.open-agentic-energy.workers.dev
// Deploy from the repository root: npx wrangler@4 deploy --config deploy/cloudflare/grants.jsonc
// The site's own _headers file sets the CORS and worker headers (docs/deployment.md).
{
  "name": "fernbrook-grants",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../sites/grants"
  }
}
